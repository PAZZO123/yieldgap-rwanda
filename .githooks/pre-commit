#!/bin/sh
# Refuse commits whose author is not a team member (.github/allowed-authors.txt).
# Enable once per clone:  git config core.hooksPath .githooks
for py in python3 python; do
  if "$py" -c "" >/dev/null 2>&1; then
    exec "$py" "$(git rev-parse --show-toplevel)/tools/check_commits.py" --author
  fi
done
echo "pre-commit: Python not found, cannot check the commit author." >&2
exit 1
