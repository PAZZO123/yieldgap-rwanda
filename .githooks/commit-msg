#!/bin/sh
# Refuse Co-authored-by trailers for anyone outside the team (.github/allowed-authors.txt).
# Enable once per clone:  git config core.hooksPath .githooks
for py in python3 python; do
  if "$py" -c "" >/dev/null 2>&1; then
    exec "$py" "$(git rev-parse --show-toplevel)/tools/check_commits.py" --message "$1"
  fi
done
echo "commit-msg: Python not found, cannot check co-authors." >&2
exit 1
